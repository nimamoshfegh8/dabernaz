{
  "id": "./",
  "name": "Dabernaz Game Club",
  "short_name": "Dabernaz",
  "description": "باشگاه بازی و رقابت دابرناز",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#08080b",
  "theme_color": "#09090c",
