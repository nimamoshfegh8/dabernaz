Options -Indexes
RewriteEngine On

# Never expose dotfiles or local tool state on Apache/cPanel.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]

# Protect runtime state even when the private directory is created at runtime.
RewriteRule ^\.private(?:/|$) - [F,L,NC]

# Do not expose source, test, migration, build, or repository metadata on shared hosting.
RewriteRule ^(?:\.git|\.wrangler|node_modules|functions|workers|migrations|scripts|tests|docs|src|android|android-app|dabernaz_pro)(?:/|$) - [F,L,NC]

# API endpoint for ordinary Apache/cPanel PHP hosting.
RewriteRule ^api(?:/.*)?$ api.php [QSA,L]

# Do not expose server entry points, package manifests, SQL dumps, or local databases.
<FilesMatch "^(server\.js|package(-lock)?\.json|README(\.fa)?\.md|.*\.(sql|sqlite|sqlite3|db|pem|key))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
